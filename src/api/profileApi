import { apiRequest } from './client';

export type UserProfile = {
  id: string;
  fullName: string;
  email: string;
  age?: number;
  weight?: number;
  height?: number;
  smoking?: boolean;
  alcohol?: string;
  sport?: boolean;
  heredity?: boolean;
};

// Получить профиль
export async function getProfileApi() {
  return apiRequest<UserProfile>('/api/user/info', {
    method: 'GET',
    auth: true,
  });
}