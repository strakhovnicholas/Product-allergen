@startuml scan-service-use-case
' UC scan-service — вертикальная компоновка под A4 (портрет)

top to bottom direction
skinparam shadowing false
skinparam roundcorner 0
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam linetype ortho

skinparam nodesep 55
skinparam ranksep 48
skinparam padding 10
skinparam wrapWidth 120

skinparam actorStyle stickman
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor black
}

title Диаграмма вариантов использования — scan-service

actor "Пользователь\n(Mobile App)" as User
actor "GigaChat API" as Giga

User -[hidden]right- Giga

rectangle "scan-service" {

  usecase "UC-S-01\nСканирование состава\n(фото этикетки)" as UC1

  usecase "Проверка\nтокена шлюза" as UC_GW
  usecase "Загрузка профиля\n(Feign → user)" as UC3
  usecase "AI-анализ изображения\n(Vision)" as UC4
  usecase "Разбор JSON\nи оценка риска" as UC5
  usecase "Сохранение\nистории скана" as UC_SAVE
  usecase "Возврат результата\nклиенту" as UC6

  usecase "Отправка в Kafka\n(опционально)" as UC_Kafka

  UC1 -[hidden]down- UC_GW
  UC_GW -[hidden]down- UC3
  UC3 -[hidden]down- UC4
  UC4 -[hidden]down- UC5
  UC5 -[hidden]down- UC_SAVE
  UC_SAVE -[hidden]down- UC6
}

User --> UC1
User <-- UC6
UC4 ..> Giga : HTTPS Vision

UC1 ..> UC_GW : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>
UC1 ..> UC_SAVE : <<include>>
UC1 ..> UC6 : <<include>>
UC1 ..> UC_Kafka : <<extend>>

note right of UC_Kafka
  SCAN_KAFKA_ENABLED=true
  Топик: scan-ai-requests
  Иначе — прямой вызов GigaChat
end note

note bottom of UC5
  ScanAnalysisResultDto:
  composition, dangerousComponents,
  riskLevel (LOW/MEDIUM/HIGH),
  clinicalNoteForDoctor
end note

note as API_REF #FFFFCC
  **API:** POST /scans/analyze (multipart image)
  GET /scans/{id} · GET /scans/history
end note

@enduml
