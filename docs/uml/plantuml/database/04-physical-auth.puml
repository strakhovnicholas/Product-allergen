@startuml database-physical-auth
allowmixing

skinparam shadowing false
skinparam roundcorner 0
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 10
skinparam linetype ortho
skinparam classAttributeIconSize 0

skinparam entity {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam database {
  BackgroundColor #E8F4FC
  BorderColor black
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor black
}

title Физическая модель — auth-service (PostgreSQL allergen_pg + Redis)

hide circle
hide methods

database "PostgreSQL\nallergen_pg :5432" as pg

database "Redis\n:6379" as redis_db

entity "users" as users {
  * **id** : UUID <<PK>>
  --
  * email : VARCHAR(255) <<UNIQUE, NOT NULL>>
  * password : VARCHAR(60) <<BCrypt, NOT NULL>>
  is_active : BOOLEAN <<NOT NULL, default true>>
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
  ..
  UNIQUE (email)
}

entity "refresh_token\n<<Redis STRING>>" as rt_key {
  * **key** : refresh_token <<PK>>
  --
  value : email
  TTL : 7 дней
}

entity "user_tokens:<email>\n<<Redis SET>>" as rt_set {
  * **key** : user_tokens:<email>
  --
  members : SET<refresh_token>
  TTL : 7 дней
}

pg .. users : schema public
redis_db .. rt_key
redis_db .. rt_set

users ||..o{ rt_key : "1 .. *\nemail в value"
users ||..|| rt_set : "1 .. 1\nпо email"
rt_set ||..o{ rt_key : содержит токены

note right of users
  JPA @Entity User.
  Hibernate ddl-auto=update.
  id генерируется UUID.
  Пароль — BCrypt (Spring Security).
end note

note right of rt_key
  RefreshTokenService.saveRefreshToken():
  SET token → email.
  Проверка при /auth/refresh.
  Удаление при logout.
end note

note bottom of rt_set
  Индекс активных refresh-токенов
  пользователя. Используется в
  revokeOldTokensByEmail() при
  повторном login (одна сессия).
end note

note as N_JWT #FFFFCC
  **Access-токен (JWT)** в БД не хранится —
  stateless, срок 15 мин (jwt.access.expiration).
  Refresh-токен — JWT + запись в Redis.
end note

@enduml
