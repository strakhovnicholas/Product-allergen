@startuml analytics-service-use-case
' Классический UML + отступы против наложений
skinparam shadowing false
skinparam roundcorner 0
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam handwritten false

skinparam nodesep 80
skinparam ranksep 80
skinparam padding 14
skinparam wrapWidth 160
skinparam minClassWidth 100

skinparam actorStyle stickman
skinparam actor {
  BackgroundColor white
  BorderColor black
}

skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FEFECE
  BorderColor black
  ArrowColor black
}
skinparam interface {
  BackgroundColor #FEFECE
  BorderColor black
}

skinparam package {
  BackgroundColor white
  BorderColor black
  FontStyle bold
}

skinparam component {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam node {
  BackgroundColor white
  BorderColor black
}
skinparam database {
  BackgroundColor white
  BorderColor black
}

skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #FEFECE
  ActorBackgroundColor white
  ActorBorderColor black
  BoxBackgroundColor #F5F5F5
  BoxBorderColor black
}
skinparam ParticipantPadding 28
skinparam BoxPadding 14
skinparam sequenceMessageAlign center

skinparam note {
  BackgroundColor #FFFFCC
  BorderColor black
}

title Диаграмма вариантов использования — analytics-service

skinparam nodesep 100
skinparam ranksep 100

left to right direction

actor "Клиент" as Client
actor "API Gateway" as Gateway
Client -[hidden]down- Gateway

rectangle "analytics-service" {

  package "Сценарии API" as P_MAIN {
    usecase "UC-01 Генерация\nмедотчёта\nGET /reports/generate" as UC1
    usecase "UC-02 Скачивание PDF\nGET /reports/download" as UC2
    UC1 -[hidden]down- UC2
  }

  package "Общие действия" as P_SUB {
    usecase "Проверка\nX-Internal-Gateway-Token" as UC_GW
    usecase "Загрузка данных\nчерез Feign" as UC_Feign
    usecase "AI-анализ\nKafka → GigaChat" as UC_AI
    usecase "Формирование PDF\n(JasperReports)" as UC_PDF
    usecase "Сохранение отчёта\nв PostgreSQL" as UC_DB
    UC_GW -[hidden]down- UC_Feign
    UC_Feign -[hidden]down- UC_AI
    UC_AI -[hidden]down- UC_PDF
    UC_PDF -[hidden]down- UC_DB
  }

  P_MAIN -[hidden]right- P_SUB
}

Client --> UC1
Client --> UC2
Gateway --> UC1
Gateway --> UC2

UC1 ..> UC_GW : <<include>>
UC2 ..> UC_GW : <<include>>

UC1 ..> UC_Feign : <<include>>
UC1 ..> UC_AI : <<include>>
UC1 ..> UC_PDF : <<include>>

UC2 ..> UC_PDF : <<include>>

UC1 ..> UC_DB : <<extend>>

note right of UC_AI
  Публикация ReportDataDto
  в топик report-data-requests,
  асинхронный вызов GigaChat,
  обогащение AnalysisResultDto
end note

@enduml
