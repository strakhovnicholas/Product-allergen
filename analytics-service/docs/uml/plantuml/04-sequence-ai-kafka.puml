@startuml analytics-service-sequence-ai-kafka
' Классический UML + отступы против наложений
skinparam shadowing false
skinparam roundcorner 0
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam handwritten false

skinparam nodesep 80
skinparam ranksep 80
skinparam padding 14
skinparam wrapWidth 160
skinparam minClassWidth 100

skinparam actorStyle stickman
skinparam actor {
  BackgroundColor white
  BorderColor black
}

skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FEFECE
  BorderColor black
  ArrowColor black
}
skinparam interface {
  BackgroundColor #FEFECE
  BorderColor black
}

skinparam package {
  BackgroundColor white
  BorderColor black
  FontStyle bold
}

skinparam component {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam node {
  BackgroundColor white
  BorderColor black
}
skinparam database {
  BackgroundColor white
  BorderColor black
}

skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #FEFECE
  ActorBackgroundColor white
  ActorBorderColor black
  BoxBackgroundColor #F5F5F5
  BoxBorderColor black
}
skinparam ParticipantPadding 28
skinparam BoxPadding 14
skinparam sequenceMessageAlign center

skinparam note {
  BackgroundColor #FFFFCC
  BorderColor black
}

title Диаграмма последовательности — AI-анализ через Kafka → GigaChat

skinparam ParticipantPadding 32

box "analytics-service" #F5F5F5
  participant "ReportService" as S
  participant "ReportDataProducer" as Prod
  participant "AiAnalysisConsumer" as Cons
  participant "GigaChatService" as GigaSvc
end box

queue "Kafka\nreport-data-requests" as Kafka
participant "GigaChat API\n(Sber)" as Giga

note over Prod, Cons
  Зависимости уже в pom.xml
  (spring-kafka, gigachat-java),
  реализация — в разработке
end note

S -> S : fillReport()\nсобран ReportDataDto
activate S

S -> Prod : send(key=userId, value=dto)
activate Prod
Prod -> Kafka : produce message
deactivate Prod

... асинхронно ...

Kafka -> Cons : @KafkaListener
activate Cons
Cons -> GigaSvc : buildPrompt(dto)
activate GigaSvc

GigaSvc -> GigaSvc : AuthClient OAuth\nscope GIGACHAT_API_PERS
GigaSvc -> Giga : POST completions\n(model GIGA_CHAT_MAX_2)
activate Giga
Giga --> GigaSvc : doctorRecommendations (HTML)
deactivate Giga

GigaSvc -> GigaSvc : merge symptoms,\nproducts, proteins,\ntrace elements
GigaSvc --> Cons : AnalysisResultDto
deactivate GigaSvc

Cons -> Cons : callback / cache /\nобновление ReportDataDto
Cons --> S : enriched analysis
deactivate Cons

deactivate S

@enduml
