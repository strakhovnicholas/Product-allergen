@startuml analytics-service-deployment
' Классический UML + отступы против наложений
skinparam shadowing false
skinparam roundcorner 0
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam handwritten false

skinparam nodesep 80
skinparam ranksep 80
skinparam padding 14
skinparam wrapWidth 160
skinparam minClassWidth 100

skinparam actorStyle stickman
skinparam actor {
  BackgroundColor white
  BorderColor black
}

skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FEFECE
  BorderColor black
  ArrowColor black
}
skinparam interface {
  BackgroundColor #FEFECE
  BorderColor black
}

skinparam package {
  BackgroundColor white
  BorderColor black
  FontStyle bold
}

skinparam component {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam node {
  BackgroundColor white
  BorderColor black
}
skinparam database {
  BackgroundColor white
  BorderColor black
}

skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #FEFECE
  ActorBackgroundColor white
  ActorBorderColor black
  BoxBackgroundColor #F5F5F5
  BoxBorderColor black
}
skinparam ParticipantPadding 28
skinparam BoxPadding 14
skinparam sequenceMessageAlign center

skinparam note {
  BackgroundColor #FFFFCC
  BorderColor black
}

title Диаграмма развёртывания — analytics-service

skinparam nodesep 70
skinparam ranksep 60
left to right direction

node "<<device>>\nКлиент" as N_Client {
  artifact "Mobile / Web App" as AppClient
}

node "<<device>>\nDocker Host" as N_Host {

  node "<<container>>\nAPI Gateway\n:8080" as N_GW {
    artifact "gateway-service.jar" as JarGW
  }

  node "<<container>>\nanalytics-service\n:8080" as N_App {
    artifact "analytics-service.jar\nSpring Boot 3.5 / Java 17" as Jar
  }

  node "<<device>>\nPostgreSQL\n:5433" as N_Pg {
    database "report_pg\n(medical_reports)" as DB_Pg
  }

  node "<<device>>\nKafka\n:9092" as N_Kafka {
    database "report-data-requests" as Topic
  }

  N_GW -[hidden]right- N_App
  N_App -[hidden]right- N_Pg
  N_Pg -[hidden]right- N_Kafka
}

node "<<external>>\nGigaChat (Sber)" as N_Giga {
  artifact "OAuth + Completions API" as GigaAPI
}

N_Client -[hidden]right- N_Host
N_Host -[hidden]right- N_Giga

AppClient --> JarGW : HTTPS
JarGW --> Jar : internal\nX-Internal-Gateway-Token\nX-User-Id
Jar --> JarGW : Feign\n/api/*
Jar --> DB_Pg : JDBC
Jar --> Topic : Kafka producer
Jar --> GigaAPI : HTTPS

note bottom of N_App
  Docker image: n1vvas1e/analytics-service:v1
  Network: backend-net
  Env: INTERNAL_SECRET,
  SPRING_DATASOURCE_*,
  KAFKA_BOOTSTRAP_SERVERS,
  GIGACHAT_AUTH_KEY
end note

@enduml
