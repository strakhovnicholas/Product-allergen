@startuml user-service-use-case
' Классический UML + отступы против наложений
skinparam shadowing false
skinparam roundcorner 0
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam handwritten false

skinparam nodesep 80
skinparam ranksep 80
skinparam padding 14
skinparam wrapWidth 160
skinparam minClassWidth 100

skinparam actorStyle stickman
skinparam actor {
  BackgroundColor white
  BorderColor black
}

skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FEFECE
  BorderColor black
  ArrowColor black
}
skinparam interface {
  BackgroundColor #FEFECE
  BorderColor black
}

skinparam package {
  BackgroundColor white
  BorderColor black
  FontStyle bold
}

skinparam component {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam node {
  BackgroundColor white
  BorderColor black
}
skinparam database {
  BackgroundColor white
  BorderColor black
}

skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #FEFECE
  ActorBackgroundColor white
  ActorBorderColor black
  BoxBackgroundColor #F5F5F5
  BoxBorderColor black
}
skinparam ParticipantPadding 28
skinparam BoxPadding 14
skinparam sequenceMessageAlign center

skinparam note {
  BackgroundColor #FFFFCC
  BorderColor black
}

title Диаграмма вариантов использования — user-service

skinparam nodesep 90
skinparam ranksep 90
left to right direction

actor "Пользователь\n(через клиент)" as Client
actor "API Gateway" as GW
actor "analytics-service" as Analytics

rectangle "user-service" {

  package "Профиль и дневник" as P_DIARY {
    usecase "UC-01 Управление\nпрофилем\n/api/user/info" as UC1
    usecase "UC-02 Учёт приёмов\nпищи\n/api/feelings/food" as UC2
    usecase "UC-03 Учёт симптомов\n/api/feelings/symptoms" as UC3
    usecase "UC-04 Учёт самочувствия\n/api/feelings/common" as UC4
    usecase "UC-05 Учёт лекарств\n/api/medicines,\n/api/feelings/medicines" as UC5
    usecase "UC-06 Заметки\n/api/notes" as UC6
    UC1 -[hidden]down- UC2
    UC2 -[hidden]down- UC3
    UC3 -[hidden]down- UC4
    UC4 -[hidden]down- UC5
    UC5 -[hidden]down- UC6
  }

  package "Анализ и справочники" as P_ANAL {
    usecase "UC-07 Анализ\nеда—симптом\n/api/food-analyzer/analyze" as UC7
    usecase "UC-08 Справочник\nпродуктов\n/api/food" as UC8
    usecase "UC-09 Справочник\nсимптомов\n/api/symptoms" as UC9
    UC7 -[hidden]down- UC8
    UC8 -[hidden]down- UC9
  }

  package "Общие действия" as P_SUB {
    usecase "Проверка\nвнутреннего токена\nшлюза" as UC_Int
    usecase "Извлечение\nX-User-Id" as UC_Uid
    UC_Int -[hidden]down- UC_Uid
  }

  P_DIARY -[hidden]right- P_ANAL
  P_ANAL -[hidden]right- P_SUB
}

Client --> UC1
Client --> UC2
Client --> UC3
Client --> UC4
Client --> UC5
Client --> UC6
Client --> UC7
Client --> UC8
Client --> UC9
GW --> UC7
Analytics --> UC7

UC1 ..> UC_Int : <<include>>
UC2 ..> UC_Int : <<include>>
UC3 ..> UC_Int : <<include>>
UC4 ..> UC_Int : <<include>>
UC5 ..> UC_Int : <<include>>
UC6 ..> UC_Int : <<include>>
UC7 ..> UC_Int : <<include>>
UC8 ..> UC_Int : <<include>>
UC9 ..> UC_Int : <<include>>

UC1 ..> UC_Uid : <<include>>
UC2 ..> UC_Uid : <<include>>
UC3 ..> UC_Uid : <<include>>
UC4 ..> UC_Uid : <<include>>
UC5 ..> UC_Uid : <<include>>
UC6 ..> UC_Uid : <<include>>
UC7 ..> UC_Uid : <<include>>
UC8 ..> UC_Uid : <<include>>
UC9 ..> UC_Uid : <<include>>

UC7 ..> UC2 : <<extend>>
note right of UC7
  Анализ требует накопленных
  записей о питании и симптомах
end note

@enduml
