@startuml user-service-component
' Классический UML + отступы против наложений
skinparam shadowing false
skinparam roundcorner 0
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam handwritten false

skinparam nodesep 80
skinparam ranksep 80
skinparam padding 14
skinparam wrapWidth 160
skinparam minClassWidth 100

skinparam actorStyle stickman
skinparam actor {
  BackgroundColor white
  BorderColor black
}

skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FEFECE
  BorderColor black
  ArrowColor black
}
skinparam interface {
  BackgroundColor #FEFECE
  BorderColor black
}

skinparam package {
  BackgroundColor white
  BorderColor black
  FontStyle bold
}

skinparam component {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam node {
  BackgroundColor white
  BorderColor black
}
skinparam database {
  BackgroundColor white
  BorderColor black
}

skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #FEFECE
  ActorBackgroundColor white
  ActorBorderColor black
  BoxBackgroundColor #F5F5F5
  BoxBorderColor black
}
skinparam ParticipantPadding 28
skinparam BoxPadding 14
skinparam sequenceMessageAlign center

skinparam note {
  BackgroundColor #FFFFCC
  BorderColor black
}

title Диаграмма компонентов — user-service

skinparam nodesep 60
skinparam ranksep 50
left to right direction

interface "HTTP / JSON" as REST

actor "API Gateway" as GW
actor "analytics-service" as AN

package "user-service" as SYS {
  component "REST Controllers" as CTRL
  component "InternalGatewayFilter" as FILT
  component "UserIdArgumentResolver" as RES
  component "Domain Services" as SVC
  component "FoodComponentAnalyzer" as ANA
  component "JPA Repositories" as REPO

  FILT -[hidden]down- CTRL
  CTRL -[hidden]right- SVC
  SVC -[hidden]right- ANA
  ANA -[hidden]right- REPO
  RES ..> CTRL
}

database "PostgreSQL\n(user_pg)" as PG
database "MongoDB\n(health_tracker)" as MG

GW --> REST
REST --> FILT
FILT --> CTRL
CTRL --> SVC
SVC --> ANA
SVC --> REPO
REPO --> PG
SVC --> MG : документы\nдневника

AN --> REST : Feign через GW

@enduml
