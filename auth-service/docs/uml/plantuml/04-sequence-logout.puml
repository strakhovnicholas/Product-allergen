@startuml auth-service-sequence-logout
' Классический UML + отступы против наложений
skinparam shadowing false
skinparam roundcorner 0
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam handwritten false

skinparam nodesep 80
skinparam ranksep 80
skinparam padding 14
skinparam wrapWidth 160
skinparam minClassWidth 100

skinparam actorStyle stickman
skinparam actor {
  BackgroundColor white
  BorderColor black
}

skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FEFECE
  BorderColor black
  ArrowColor black
}
skinparam interface {
  BackgroundColor #FEFECE
  BorderColor black
}

skinparam package {
  BackgroundColor white
  BorderColor black
  FontStyle bold
}

skinparam component {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam node {
  BackgroundColor white
  BorderColor black
}
skinparam database {
  BackgroundColor white
  BorderColor black
}

skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #FEFECE
  ActorBackgroundColor white
  ActorBorderColor black
  BoxBackgroundColor #F5F5F5
  BoxBorderColor black
}
skinparam ParticipantPadding 28
skinparam BoxPadding 14
skinparam sequenceMessageAlign center

skinparam note {
  BackgroundColor #FFFFCC
  BorderColor black
}

title Диаграмма последовательности — UC-03 Выход (POST /auth/logout)

skinparam ParticipantPadding 40

actor "Клиент" as Client
participant "AuthController" as C
participant "AuthService" as S
participant "RefreshTokenService" as RTS
database "Redis" as Redis

Client -> C : POST /auth/logout
activate C
C -> S : logout(refreshToken)
activate S

alt #FFF8E1 токен не передан
  S --> C : (без отзыва)
else #ECFFEC токен передан
  S -> RTS : revokeToken(refreshToken)
  activate RTS
  RTS -> Redis : GET / DEL / SREM
  Redis --> RTS : OK
  deactivate RTS
  S --> C : void
end

deactivate S
C --> Client : HTTP 200
deactivate C

@enduml
