@startuml auth-service-sequence-refresh
' Классический UML + отступы против наложений
skinparam shadowing false
skinparam roundcorner 0
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam handwritten false

skinparam nodesep 80
skinparam ranksep 80
skinparam padding 14
skinparam wrapWidth 160
skinparam minClassWidth 100

skinparam actorStyle stickman
skinparam actor {
  BackgroundColor white
  BorderColor black
}

skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FEFECE
  BorderColor black
  ArrowColor black
}
skinparam interface {
  BackgroundColor #FEFECE
  BorderColor black
}

skinparam package {
  BackgroundColor white
  BorderColor black
  FontStyle bold
}

skinparam component {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam node {
  BackgroundColor white
  BorderColor black
}
skinparam database {
  BackgroundColor white
  BorderColor black
}

skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #FEFECE
  ActorBackgroundColor white
  ActorBorderColor black
  BoxBackgroundColor #F5F5F5
  BoxBorderColor black
}
skinparam ParticipantPadding 28
skinparam BoxPadding 14
skinparam sequenceMessageAlign center

skinparam note {
  BackgroundColor #FFFFCC
  BorderColor black
}

title Диаграмма последовательности — UC-04 Обновление (POST /auth/refresh)

skinparam ParticipantPadding 32

actor "Клиент" as Client

box "auth-service" #F5F5F5
  participant "AuthController" as C
  participant "AuthService" as S
  participant "JwtService" as J
  participant "RefreshTokenService" as RTS
  participant "UserRepository" as R
end box

database "PostgreSQL" as PG
database "Redis" as Redis

Client -> C : POST /auth/refresh
activate C
C -> S : refresh(refreshToken)
activate S

S -> J : validateToken(refresh)
activate J
J --> S : valid?
deactivate J

alt #FFECEC невалидный JWT
  S --> C : InvalidRefreshTokenException
  deactivate S
  C --> Client : HTTP 401
else #ECFFEC JWT корректен
  S -> RTS : isValid(refreshToken)
  activate RTS
  RTS -> Redis : EXISTS
  Redis --> RTS : boolean
  RTS --> S : boolean
  deactivate RTS

  alt #FFECEC токен отозван
    S --> C : InvalidRefreshTokenException
    deactivate S
    C --> Client : HTTP 401
  else #ECFFEC токен активен
    S -> RTS : getEmail(refreshToken)
    activate RTS
    RTS -> Redis : GET
    Redis --> RTS : email
    RTS --> S : email
    deactivate RTS

    S -> R : findByEmail(email)
    activate R
    R -> PG : SELECT
    PG --> R : User
    R --> S : User
    deactivate R

    S -> J : generateAccessToken()
    activate J
    J --> S : newAccessToken
    deactivate J

    S --> C : AuthResponse
    deactivate S
    C --> Client : HTTP 200
  end
end

deactivate C

@enduml
