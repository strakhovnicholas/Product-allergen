@startuml auth-service-component
' Классический UML + отступы против наложений
skinparam shadowing false
skinparam roundcorner 0
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam handwritten false

skinparam nodesep 80
skinparam ranksep 80
skinparam padding 14
skinparam wrapWidth 160
skinparam minClassWidth 100

skinparam actorStyle stickman
skinparam actor {
  BackgroundColor white
  BorderColor black
}

skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FEFECE
  BorderColor black
  ArrowColor black
}
skinparam interface {
  BackgroundColor #FEFECE
  BorderColor black
}

skinparam package {
  BackgroundColor white
  BorderColor black
  FontStyle bold
}

skinparam component {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam node {
  BackgroundColor white
  BorderColor black
}
skinparam database {
  BackgroundColor white
  BorderColor black
}

skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #FEFECE
  ActorBackgroundColor white
  ActorBorderColor black
  BoxBackgroundColor #F5F5F5
  BoxBorderColor black
}
skinparam ParticipantPadding 28
skinparam BoxPadding 14
skinparam sequenceMessageAlign center

skinparam note {
  BackgroundColor #FFFFCC
  BorderColor black
}

title Диаграмма компонентов — auth-service

skinparam nodesep 60
skinparam ranksep 50
left to right direction

interface "HTTP / JSON" as REST

package "auth-service" as SYS {

  component "AuthController" as CTRL
  component "AuthService" as SVC
  component "JwtService" as JWT
  component "RefreshTokenService" as RTS
  component "UserRepository" as REPO
  component "SecurityConfig" as SEC
  component "GlobalExceptionHandler" as ERR

  CTRL -[hidden]right- SVC
  SVC -[hidden]right- JWT
  JWT -[hidden]right- RTS
  RTS -[hidden]right- REPO
  SEC -[hidden]down- SVC
  ERR -[hidden]down- CTRL
}

database "PostgreSQL\n(users)" as PG
database "Redis\n(refresh)" as Redis

REST -down-> CTRL
CTRL --> SVC
SVC --> JWT
SVC --> RTS
SVC --> REPO
SEC ..> SVC
ERR ..> CTRL
REPO -down-> PG : JDBC/JPA
RTS -down-> Redis

@enduml
