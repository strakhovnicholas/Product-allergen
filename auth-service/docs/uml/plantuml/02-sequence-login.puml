@startuml auth-service-sequence-login
' Классический UML + отступы против наложений
skinparam shadowing false
skinparam roundcorner 0
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam handwritten false

skinparam nodesep 80
skinparam ranksep 80
skinparam padding 14
skinparam wrapWidth 160
skinparam minClassWidth 100

skinparam actorStyle stickman
skinparam actor {
  BackgroundColor white
  BorderColor black
}

skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FEFECE
  BorderColor black
  ArrowColor black
}
skinparam interface {
  BackgroundColor #FEFECE
  BorderColor black
}

skinparam package {
  BackgroundColor white
  BorderColor black
  FontStyle bold
}

skinparam component {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam node {
  BackgroundColor white
  BorderColor black
}
skinparam database {
  BackgroundColor white
  BorderColor black
}

skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #FEFECE
  ActorBackgroundColor white
  ActorBorderColor black
  BoxBackgroundColor #F5F5F5
  BoxBorderColor black
}
skinparam ParticipantPadding 28
skinparam BoxPadding 14
skinparam sequenceMessageAlign center

skinparam note {
  BackgroundColor #FFFFCC
  BorderColor black
}

title Диаграмма последовательности — UC-02 Вход (POST /auth/login)

skinparam ParticipantPadding 32

actor "Клиент" as Client

box "auth-service" #F5F5F5
  participant "AuthController" as C
  participant "AuthService" as S
  participant "AuthenticationManager" as AM
  participant "UserRepository" as R
  participant "JwtService" as J
  participant "RefreshTokenService" as RTS
end box

box "Хранилища" #FFFFFF
  database "PostgreSQL" as PG
  database "Redis" as Redis
end box

Client -> C : POST /auth/login
activate C
C -> S : login(request)
activate S

S -> AM : authenticate(email, password)
activate AM
AM -> R : findByEmail(email)
activate R
R -> PG : SELECT user
PG --> R : результат
R --> AM : UserDetails
deactivate R

alt #FFECEC неверные учётные данные
  AM --> S : AuthenticationException
  deactivate AM
  S --> C : InvalidCredentialsException
  deactivate S
  C --> Client : HTTP 401
else #ECFFEC успешный вход
  AM --> S : OK
  deactivate AM

  S -> R : findByEmail(email)
  activate R
  R -> PG : SELECT user
  PG --> R : User
  R --> S : User
  deactivate R

  S -> J : generateAccessToken()
  activate J
  J --> S : accessToken
  deactivate J

  S -> J : generateRefreshToken()
  activate J
  J --> S : refreshToken
  deactivate J

  S -> RTS : revokeOldTokensByEmail()
  activate RTS
  RTS -> Redis : DEL старые ключи
  Redis --> RTS : OK
  deactivate RTS

  S -> RTS : saveRefreshToken()
  activate RTS
  RTS -> Redis : SET, TTL 7 дней
  Redis --> RTS : OK
  deactivate RTS

  S --> C : AuthResponse
  deactivate S
  C --> Client : HTTP 200
end

deactivate C

@enduml
