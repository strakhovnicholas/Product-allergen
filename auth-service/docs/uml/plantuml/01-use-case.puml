@startuml auth-service-use-case
' Классический UML + отступы против наложений
skinparam shadowing false
skinparam roundcorner 0
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam handwritten false

skinparam nodesep 80
skinparam ranksep 80
skinparam padding 14
skinparam wrapWidth 160
skinparam minClassWidth 100

skinparam actorStyle stickman
skinparam actor {
  BackgroundColor white
  BorderColor black
}

skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FEFECE
  BorderColor black
  ArrowColor black
}
skinparam interface {
  BackgroundColor #FEFECE
  BorderColor black
}

skinparam package {
  BackgroundColor white
  BorderColor black
  FontStyle bold
}

skinparam component {
  BackgroundColor #FEFECE
  BorderColor black
}
skinparam node {
  BackgroundColor white
  BorderColor black
}
skinparam database {
  BackgroundColor white
  BorderColor black
}

skinparam sequence {
  ArrowColor black
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor #FEFECE
  ActorBackgroundColor white
  ActorBorderColor black
  BoxBackgroundColor #F5F5F5
  BoxBorderColor black
}
skinparam ParticipantPadding 28
skinparam BoxPadding 14
skinparam sequenceMessageAlign center

skinparam note {
  BackgroundColor #FFFFCC
  BorderColor black
}

title Диаграмма вариантов использования — auth-service

skinparam nodesep 100
skinparam ranksep 100

left to right direction

actor "Клиент" as Client
actor "API Gateway" as Gateway
Client -[hidden]down- Gateway

rectangle "auth-service" {

  package "Сценарии API" as P_MAIN {
    usecase "UC-01 Регистрация\nPOST /auth/register" as UC1
    usecase "UC-02 Вход\nPOST /auth/login" as UC2
    usecase "UC-03 Выход\nPOST /auth/logout" as UC3
    usecase "UC-04 Обновление токенов\nPOST /auth/refresh" as UC4
    UC1 -[hidden]down- UC2
    UC2 -[hidden]down- UC3
    UC3 -[hidden]down- UC4
  }

  package "Общие действия" as P_SUB {
    usecase "Валидация\nвходных данных" as UC_Val
    usecase "Выдача JWT" as UC_JWT
    usecase "Хранение refresh\nв Redis" as UC_Redis
    UC_Val -[hidden]down- UC_JWT
    UC_JWT -[hidden]down- UC_Redis
  }

  P_MAIN -[hidden]right- P_SUB
}

Client --> UC1
Client --> UC2
Client --> UC3
Client --> UC4
Gateway --> UC2
Gateway --> UC4

UC1 -[hidden]right- UC_Val
UC1 ..> UC_Val : <<include>>
UC2 ..> UC_Val : <<include>>
UC3 ..> UC_Val : <<include>>
UC4 ..> UC_Val : <<include>>

UC1 ..> UC_JWT : <<include>>
UC2 ..> UC_JWT : <<include>>
UC4 ..> UC_JWT : <<include>>

UC2 ..> UC_Redis : <<include>>
UC3 ..> UC_Redis : <<include>>
UC4 ..> UC_Redis : <<include>>

@enduml
